# Скопируйте в .env (на Netrun — секреты в панели проекта, файл с именем .env)
ANTHROPIC_API_KEY=
TELEGRAM_BOT_TOKEN=
# Пусто → бот на /start пришлёт ваш chat_id
TELEGRAM_CHAT_ID=

# Почта (необязательно). Для Gmail: imap.gmail.com + пароль приложения
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=

# Секретная iCal-ссылка календаря (необязательно)
ICS_URL=

# Где хранить state.json, usage.jsonl и логи. На Netrun: /data
# DATA_DIR=/data
